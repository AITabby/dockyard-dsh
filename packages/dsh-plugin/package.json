{
  "name": "@dockyard-dsh/plugin",
  "version": "0.1.22",
  "description": "A native account-pool and provider plugin for DeepSeek Harness (macOS and Windows).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AITabby/dockyard-dsh.git"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./lib/client.js",
    "./remote": "./src/dockyard-typert.remote.mjs",
    "./typert": "./src/dockyard-typert.host.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib/client.js",
    "cordis.patch.yml",
    "SECURITY.md",
    "src/dockyard-typert-shared.mjs",
    "src/dockyard-typert.remote.mjs",
    "src/dockyard-typert.host.mjs"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepare": "node scripts/build-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "immer": "^10.1.1",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.4.3",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-alpha.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-alpha.2",
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  }
}
